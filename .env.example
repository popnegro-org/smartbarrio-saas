# Next.js / Vercel
NEXT_PUBLIC_APP_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY

# OneSignal
ONESIGNAL_APP_ID=REPLACE_ME
ONESIGNAL_REST_API_KEY=REPLACE_ME
NEXT_PUBLIC_ONESIGNAL_APP_ID=REPLACE_ME

# Evolution API
EVOLUTION_API_URL=https://whatsapp.example.com
EVOLUTION_API_KEY=REPLACE_ME
EVOLUTION_WEBHOOK_SECRET=REPLACE_ME

# n8n
N8N_WEBHOOK_BASE_URL=https://automation.example.com
AUTOMATION_SECRET=REPLACE_WITH_RANDOM_SECRET

# Generate 32 random bytes, base64 encoded (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/api/integrations/google/callback

# VPS
POSTGRES_USER=barrio
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_PASSWORD_URLENCODED=REPLACE_WITH_URL_ENCODED_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_PASSWORD_URLENCODED=REPLACE_WITH_URL_ENCODED_PASSWORD
